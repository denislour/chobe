DJANGO_SECRET_KEY=replace-for-local-development
DJANGO_DEBUG=true
DJANGO_DEMO_MODE=true
DJANGO_ALLOWED_HOSTS=localhost
# Optional: absolute path to a separate cache file; defaults to backend/cache.sqlite3.
# DJANGO_CACHE_DB_PATH=/absolute/path/to/cache.sqlite3
# Optional: absolute path to Huey storage; defaults to backend/queue.sqlite3.
# DJANGO_QUEUE_DB_PATH=/absolute/path/to/queue.sqlite3
DJANGO_FROM_EMAIL="Chobe <hello@chobe.test>"
DJANGO_SMTP_HOST=localhost
DJANGO_SMTP_PORT=1025
DJANGO_SMTP_USERNAME=
DJANGO_SMTP_PASSWORD=
DJANGO_SMTP_TLS=false
DJANGO_FRONTEND_URL=http://localhost:4200
