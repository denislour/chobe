<mjml lang="en">
  <mj-include path="./partials/head.mjml" />
  <mj-body background-color="#f5f5f0" width="530px">
    <mj-section background-color="#ffffff" border="1px solid #dedfd5" border-radius="12px" padding="24px">
      <mj-column>
        <mj-include path="./partials/header.mjml" />
        <mj-text>Hi {{ user.username }},</mj-text>
        <mj-text>Use this link to set a new password for your Chobe account:</mj-text>
        <mj-button href="{{ frontend_url }}/change-password/{{ uid }}/{{ token }}">Set new password</mj-button>
        <mj-text font-size="14px">You can also copy this link into your browser:<br /><a class="recovery-link" href="{{ frontend_url }}/change-password/{{ uid }}/{{ token }}">{{ frontend_url }}/change-password/{{ uid }}/{{ token }}</a></mj-text>
        <mj-text>This link expires in {{ minutes }} minutes and can be used once.</mj-text>
        <mj-text>If you did not request this email, you can ignore it.</mj-text>
        <mj-include path="./partials/footer.mjml" />
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
