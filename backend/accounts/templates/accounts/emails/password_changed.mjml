<mjml lang="en">
  <mj-include path="./partials/head.mjml" />
  <mj-body background-color="#f5f5f0" width="530px">
    <mj-section background-color="#ffffff" border="1px solid #dedfd5" border-radius="12px" padding="24px">
      <mj-column>
        <mj-include path="./partials/header.mjml" />
        <mj-text>Hi {{ user.username }},</mj-text>
        <mj-text>Your Chobe account password was changed successfully.</mj-text>
        <mj-text>If you made this change, no action is needed.</mj-text>
        <mj-text>If you did not make this change, use Forgot password to recover your account right away.</mj-text>
        <mj-button href="{{ frontend_url }}/forgot-password">Recover your account</mj-button>
        <mj-include path="./partials/footer.mjml" />
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
